# ─── Database (Supabase / Neon Postgres) ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/reveal

# ─── API server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# ─── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
# How long an issued token stays valid (zeit/ms format)
JWT_EXPIRES_IN=12h
# Minutes a student magic-link token is valid
MAGIC_LINK_TTL_MIN=30

# ─── Layer 3 · Synthesis (the single LLM step) ─────────────────────────
ANTHROPIC_API_KEY=
SYNTHESIS_MODEL=claude-sonnet-5
SYNTHESIS_TEMPERATURE=0.3
# Set to "manual" to emit the prompt instead of calling the API (pilot fallback)
SYNTHESIS_MODE=auto

# ─── Email (verification + welcome) ────────────────────────────────────
# Product identity + public site URL (used in email copy and links).
APP_NAME=REVEAL
APP_URL=http://localhost:5173
# "From" address — must be a sender your provider is allowed to send as.
EMAIL_FROM=REVEAL <onboarding@resend.dev>
SUPPORT_EMAIL=support@reveal.app
# Pick ONE transport:
#  A) Resend HTTP API (recommended on Render — HTTPS, no SMTP ports). Get a key
#     at resend.com; to send to arbitrary addresses, verify a sending domain.
RESEND_API_KEY=
#  B) Any SMTP provider (SendGrid, Brevo, Gmail, Mailgun, …). SendGrid/Brevo let
#     you verify a single sender without owning a domain — easiest for a pilot.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# With neither set, the API logs the code to the server console (dev fallback).

# ─── Object storage (Supabase Storage / S3-compatible) ─────────────────
STORAGE_BUCKET=reveal-uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── Frontend (apps/web, Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:4000
