# ─── Database (Neon / Supabase Postgres) ───────────────────────────────
# Local dev: postgresql://reveal:reveal@localhost:5432/reveal
# Prod: your Neon connection string (include ?sslmode=require).
DATABASE_URL=postgresql://user:password@localhost:5432/reveal

# ─── API server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS (your web URL in prod).
CORS_ORIGIN=http://localhost:5173

# ─── Auth ──────────────────────────────────────────────────────────────
# MUST be a long random string in production.
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=12h

# ─── Email (student verification; auth only) ───────────────────────────
APP_NAME=REVEAL
APP_URL=http://localhost:5173
EMAIL_FROM=REVEAL <service@radikle.org>
SUPPORT_EMAIL=service@radikle.org
# Pick ONE transport, or leave all unset to log the code to the server console.
#  A) Brevo HTTP API (recommended on Render — HTTPS, single verified sender).
BREVO_API_KEY=
#  B) Resend HTTP API (needs a verified sending domain for arbitrary recipients).
RESEND_API_KEY=
#  C) Any SMTP provider (some hosts block outbound SMTP — prefer an HTTP transport).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Frontend (apps/web, Vite) ─────────────────────────────────────────
# Point the web app at your deployed API in prod (e.g. https://reveal-api.onrender.com).
VITE_API_URL=http://localhost:4000
