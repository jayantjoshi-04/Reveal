# ─── Database (Supabase / Neon Postgres) ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/reveal

# ─── API server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# ─── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string
# How long an issued token stays valid (zeit/ms format)
JWT_EXPIRES_IN=12h
# Minutes a student magic-link token is valid
MAGIC_LINK_TTL_MIN=30

# ─── Layer 3 · Synthesis (the single LLM step) ─────────────────────────
ANTHROPIC_API_KEY=
SYNTHESIS_MODEL=claude-sonnet-5
SYNTHESIS_TEMPERATURE=0.3
# Set to "manual" to emit the prompt instead of calling the API (pilot fallback)
SYNTHESIS_MODE=auto

# ─── Email (verification + welcome) ────────────────────────────────────
# Product identity + public site URL (used in email copy and links).
APP_NAME=REVEAL
APP_URL=http://localhost:5173
# "From" address — must be a sender your provider is allowed to send as.
EMAIL_FROM=REVEAL <service@radikle.org>
SUPPORT_EMAIL=service@radikle.org
# Pick ONE transport (HTTP transports use HTTPS and work even where SMTP is blocked):
#  A) Resend HTTP API. Get a key at resend.com; arbitrary recipients need a
#     verified sending domain.
RESEND_API_KEY=
#  B) Brevo HTTP API (recommended on Render — HTTPS, no domain needed). Verify a
#     single sender at brevo.com, then create an API key under SMTP & API → API Keys.
BREVO_API_KEY=
#  C) Any SMTP provider (SendGrid, Brevo, Gmail, Mailgun, …). Note: some hosts
#     block outbound SMTP ports — prefer an HTTP transport there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# With none set, the API logs the code to the server console (dev fallback).

# ─── Object storage (Supabase Storage / S3-compatible) ─────────────────
STORAGE_BUCKET=reveal-uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── Frontend (apps/web, Vite) ─────────────────────────────────────────
VITE_API_URL=http://localhost:4000
