{
  "name": "reveal",
  "version": "0.1.0",
  "private": true,
  "description": "REVEAL — a hybrid diagnostic that helps design students discover their design domain",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "shared:build": "pnpm --filter @reveal/shared build",
    "dev:api": "pnpm shared:build && pnpm --filter @reveal/api dev",
    "dev:web": "pnpm shared:build && pnpm --filter @reveal/web dev",
    "dev": "pnpm shared:build && pnpm --parallel --filter @reveal/api --filter @reveal/web dev",
    "db:migrate": "pnpm --filter @reveal/api db:migrate",
    "db:seed": "pnpm --filter @reveal/api db:seed",
    "v2:setup": "pnpm shared:build && pnpm --filter @reveal/api v2:generate && pnpm --filter @reveal/api v2:push && pnpm --filter @reveal/api v2:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "esbuild"
    ]
  }
}
