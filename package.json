{
  "name": "reveal",
  "version": "0.1.0",
  "private": true,
  "description": "REVEAL — a hybrid diagnostic that helps design students discover their design domain",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @reveal/api dev",
    "dev:web": "pnpm --filter @reveal/web dev",
    "db:migrate": "pnpm --filter @reveal/api db:migrate",
    "db:seed": "pnpm --filter @reveal/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
